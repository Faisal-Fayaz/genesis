<component type="desktop-application">
  <id>io.github.Faisal_Fayaz.genesis</id>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Genesis</name>
  <summary>Deterministic procedural wallpapers</summary>
  <url type="homepage">https://github.com/Faisal-Fayaz/genesis</url>
  <developer id="io.github.faisal_fayaz.genesis">
    <name>Faisal Fayaz</name>
  </developer>
  <description>
    <p>
      Genesis is a procedural wallpaper engine where every image is described
      by a small JSON recipe. The same recipe always produces byte-identical
      pixels, so a wallpaper is a diff you can read, share, and revert —
      not a blob.
    </p>
    <p>
      Render curated stills, keep the ones you love starred, get a fresh
      wallpaper every morning from the daily timer, or animate a composition
      behind your windows with the cursor-reactive live mode (X11).
      Everything runs locally; there are no accounts and no network calls.
    </p>
  </description>
  <launchable type="desktop-id">io.github.Faisal_Fayaz.genesis.desktop</launchable>
